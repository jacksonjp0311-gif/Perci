{
  "schema": "perci.policy.v1",
  "about": "What agents may do without asking. Perci evaluates this structurally (argv, paths), not by keywords. posture: allow | propose_and_verify | refuse. Rules are checked refuse first, then propose_and_verify, then allow; anything unmatched gets the kind's default. A shell rule matches when every field it sets matches: program (any of), subcommand / subcommand_any, args_any OR args_prefix_any, args_any_ci (case-insensitive), flag_chars_any (short-flag letters), contains_any (raw command text). Edit freely; the sha256 of this file goes into every policy verdict.",
  "shell": {
    "default": "propose_and_verify",
    "refuse": [
      {"id": "shell.rm_root", "program": ["rm"], "flag_chars_any": "rR", "args_any": ["/", "/*", "~", "~/", "*", ".", "..", "$HOME", "C:\\", "C:/"], "reason": "recursive delete of a root, home or whole directory"},
      {"id": "shell.rm_no_preserve_root", "program": ["rm"], "args_any": ["--no-preserve-root"], "reason": "explicitly disables the root guard"},
      {"id": "shell.disk_format", "program": ["mkfs", "mkfs.ext4", "mkfs.xfs", "mkfs.vfat", "fdisk", "parted", "diskpart", "format", "wipefs"], "reason": "formats or repartitions a disk"},
      {"id": "shell.dd_device", "program": ["dd"], "args_prefix_any": ["of=/dev/"], "reason": "writes raw bytes to a device"},
      {"id": "shell.power", "program": ["shutdown", "reboot", "halt", "poweroff", "stop-computer", "restart-computer"], "reason": "powers the machine off or restarts it"},
      {"id": "git.force_push", "program": ["git"], "subcommand": "push", "args_any": ["--force", "-f", "--force-with-lease", "--mirror", "--delete"], "args_prefix_any": ["+", "--force-with-lease="], "reason": "rewrites or deletes remote history"},
      {"id": "git.no_verify", "program": ["git"], "args_any": ["--no-verify"], "subcommand_any": ["commit", "push", "merge", "rebase"], "reason": "skips hooks"},
      {"id": "shell.chmod_world", "program": ["chmod"], "args_any": ["777", "-R777", "a+rwx"], "flag_chars_any": "R", "reason": "recursive world-writable permissions"},
      {"id": "ps.remove_recurse_root", "program": ["remove-item", "rm", "del", "rmdir", "rd"], "args_any": ["C:\\", "C:/", "C:\\*", "/", "~", "$env:USERPROFILE", "$HOME"], "args_any_ci": ["-recurse", "/s"], "reason": "recursive delete of a drive root or home"},
      {"id": "shell.pipe_to_shell", "contains_any": ["| sh", "|sh", "| bash", "|bash", "| zsh", "| iex", "|iex", "| invoke-expression", "iex (", "iex(", ":(){"], "reason": "runs downloaded or generated code without review (or a fork bomb)"}
    ],
    "propose_and_verify": [
      {"id": "shell.rm", "program": ["rm", "rmdir", "del", "rd", "remove-item", "unlink", "shred"], "reason": "deletes files"},
      {"id": "git.history", "program": ["git"], "subcommand_any": ["reset", "rebase", "clean", "push", "filter-branch", "filter-repo", "reflog", "gc", "update-ref", "tag", "stash"], "reason": "changes history, deletes untracked files or publishes"},
      {"id": "git.branch_delete", "program": ["git"], "subcommand": "branch", "args_any": ["-D", "-d", "--delete"], "reason": "deletes a branch"},
      {"id": "git.checkout_discard", "program": ["git"], "subcommand_any": ["checkout", "restore"], "args_any": [".", "--", "-f", "--force"], "reason": "can discard local changes"},
      {"id": "shell.privilege", "program": ["sudo", "su", "doas", "runas", "start-process"], "reason": "elevates privileges"},
      {"id": "shell.network", "program": ["curl", "wget", "invoke-webrequest", "iwr", "invoke-restmethod", "irm", "ssh", "scp", "rsync", "nc", "ftp"], "reason": "network access"},
      {"id": "pkg.install", "program": ["npm", "pnpm", "yarn", "pip", "pip3", "cargo", "apt", "apt-get", "brew", "winget", "choco", "gem"], "subcommand_any": ["install", "add", "publish", "uninstall", "remove", "i", "yank", "login"], "reason": "installs, removes or publishes packages"},
      {"id": "shell.find_delete", "program": ["find"], "args_any": ["-delete", "-exec", "-execdir", "-ok"], "reason": "find with side effects"},
      {"id": "shell.kill", "program": ["kill", "killall", "pkill", "taskkill", "stop-process"], "reason": "stops processes"},
      {"id": "shell.chown", "program": ["chown", "chgrp", "chmod", "icacls", "takeown"], "reason": "changes ownership or permissions"},
      {"id": "shell.mv", "program": ["mv", "move", "move-item", "ren", "rename-item"], "reason": "moves or renames files"},
      {"id": "shell.redirect", "contains_any": [" > ", ">>", "| tee", "|tee", "out-file", "set-content"], "reason": "writes a file through a redirect"}
    ],
    "allow": [
      {"id": "read.fs", "program": ["ls", "dir", "pwd", "cat", "head", "tail", "wc", "rg", "grep", "tree", "stat", "file", "du", "df", "which", "where", "type", "echo", "sort", "uniq", "diff", "cmp", "sha256sum", "md5sum", "get-childitem", "gci", "get-content", "gc", "select-string", "get-item", "test-path", "resolve-path", "find"], "reason": "read-only inspection"},
      {"id": "git.read", "program": ["git"], "subcommand_any": ["status", "diff", "log", "show", "blame", "branch", "fetch", "remote", "rev-parse", "describe", "ls-files", "grep", "shortlog", "worktree", "add", "commit", "switch", "checkout", "merge-base", "lfs"], "reason": "git inspection and local, reversible commits"},
      {"id": "build.cargo", "program": ["cargo"], "subcommand_any": ["build", "check", "test", "clippy", "fmt", "doc", "bench", "tree", "metadata", "run"], "reason": "build and test the project"},
      {"id": "build.python_tests", "program": ["pytest", "python", "python3", "py"], "args_prefix_any": ["-m pytest", "-mpytest"], "args_any": ["pytest", "unittest", "--version", "-V"], "reason": "run tests"},
      {"id": "build.node_tests", "program": ["npm", "pnpm", "yarn"], "subcommand_any": ["test", "run", "ci", "ls", "list", "outdated"], "reason": "run project scripts and tests"},
      {"id": "perci.self", "program": ["perci", "perci.exe", "bug2eval"], "reason": "Perci and bug2eval are themselves governed"}
    ]
  },
  "write": {
    "default": "propose_and_verify",
    "refuse_globs": ["**/.git/**", ".git/**", "**/*.pwgt", "**/.env", "**/.env.*", "**/id_rsa*", "**/id_ed25519*", "**/*.pem", "**/*.key", "**/.ssh/**", "**/models/promotion-ledger.jsonl", "**/.perci/agent.lock"],
    "allow_globs": ["src/**", "tests/**", "docs/**", "scripts/**", "evals/**", "benches/**", "examples/**", "*.md", "config/personality.prompt"],
    "max_changed_lines": 400
  },
  "delete": {
    "default": "propose_and_verify",
    "refuse_globs": ["**/.git", "**/.git/**", ".git", ".git/**", "**/*.pwgt", "**/models/**", "models/**", "**/.ssh/**", "**/memory/**", "memory/**"]
  },
  "network": {
    "default": "propose_and_verify",
    "allow_hosts": ["127.0.0.1", "localhost", "::1"]
  },
  "commit": {
    "default": "allow",
    "refuse_flags": ["--no-verify", "-n"],
    "propose_flags": ["--amend", "--no-edit"]
  },
  "push": {
    "default": "propose_and_verify",
    "refuse_flags": ["--force", "-f", "--force-with-lease", "--mirror", "--delete"]
  },
  "sequence": {
    "about": "Order rules checked against this run's step ledger (agent_gate_step phase pre, next_step). A step belongs to a class when it equals a pattern or starts with the pattern plus a space; a step named like the class (ledger_append step \"tests\") belongs to it too. A rule fires before a step of class `before` and needs an earlier entry of class `requires` with `status` (and `phase`, when set) after the last entry of class `not_before`. Unmet: the step gets `posture` (never looser than the structural decision); when the policy already refuses the step an unmet rule is listed but adds no reason. `skip_if_targets_absent`: skip the rule when Perci verified every delete target does not exist.",
    "classes": {
      "tests": ["shell:cargo test", "shell:cargo nextest", "shell:pytest", "shell:python -m pytest", "shell:python -m unittest", "shell:npm test", "shell:pnpm test", "shell:yarn test", "shell:go test", "shell:make test", "shell:dotnet test", "shell:mvn test", "shell:gradle test", "shell:bun test", "shell:deno test", "patch"],
      "deploy": ["shell:git push", "shell:kubectl apply", "shell:helm upgrade", "shell:helm install", "shell:terraform apply", "shell:fly deploy", "shell:flyctl deploy", "shell:npm publish", "shell:cargo publish", "shell:docker push", "shell:gh release", "push"],
      "code_change": ["write", "delete"],
      "backup": ["shell:git stash", "shell:git branch", "shell:git tag", "shell:cp", "shell:rsync", "shell:tar", "shell:zip"],
      "destructive_delete": ["delete", "shell:rm", "shell:git clean", "shell:git reset", "shell:remove-item"]
    },
    "rules": [
      {"id": "seq.deploy_requires_tests", "before": "deploy", "requires": "tests", "status": "pass", "phase": "post", "not_before": "code_change", "posture": "refuse", "reason": "deploying requires tests that passed after the last code change in this run"},
      {"id": "seq.delete_requires_backup", "before": "destructive_delete", "requires": "backup", "status": "pass", "posture": "propose_and_verify", "skip_if_targets_absent": true, "reason": "deleting requires a backup earlier in this run"}
    ]
  }
}
